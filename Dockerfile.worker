# Dedicated background-worker image. Build context is the app/ directory.
# Debian provides the media system libraries; OpenCV is pinned from PyPI because
# Bookworm's 4.6 build cannot load the current YuNet ONNX model reliably.
FROM node:22-bookworm-slim AS dependencies

WORKDIR /srv/app

# better-sqlite3 remains installed for the reversible SQLite rollback path.
# These tools let npm compile it if a matching prebuild is unavailable.
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ pkg-config libsqlite3-dev \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-bookworm-slim AS runtime

WORKDIR /srv/app
ENV NODE_ENV=production \
    NODE_OPTIONS=--max-old-space-size=256 \
    FFMPEG_PATH=/usr/bin/ffmpeg \
    FFPROBE_PATH=/usr/bin/ffprobe

# Runtime media/QC contract:
# - ffmpeg/ffprobe: compositor and probes
# - python3-pil: caption-card renderer
# - pinned opencv-python-headless: QC-09 YuNet (must support the bundled ONNX)
# - tesseract + English data: QC-06 OCR on actual composited frames
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg python3 python3-pil python3-pip tesseract-ocr tesseract-ocr-eng \
  && python3 -m pip install --no-cache-dir --break-system-packages opencv-python-headless==4.10.0.84 \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --gid 10001 racun \
  && useradd --uid 10001 --gid racun --create-home --shell /usr/sbin/nologin racun

COPY --from=dependencies /srv/app/node_modules ./node_modules
COPY --chown=racun:racun package.json package-lock.json ./
COPY --chown=racun:racun lib ./lib
COPY --chown=racun:racun scripts ./scripts
# knowledge/ WAJIB ikut: lib/media/shot-planner memuat kontrak kamera 14 mode
# dari knowledge/rules/modes.md saat modul di-load (slice 1, 19 Agu). Tanpa
# baris ini sumbu mode MATI DIAM-DIAM di container worker — persis tempat
# planShots benar-benar berjalan di produksi — dan prompt keluar tanpa kontrak
# kamera tanpa satu pun kegagalan terlihat. Dijaga tests/mode-sumbu-planner.
COPY --chown=racun:racun knowledge ./knowledge
COPY --chown=racun:racun assets/fonts ./assets/fonts
COPY --chown=racun:racun assets/models ./assets/models
COPY --chown=racun:racun assets/music ./assets/music
# assets/probe WAJIB ikut: probe kapabilitas klasifikasi
# (lib/media/kapabilitas-klasifikasi.ts) membaca fixture berteks dari sini untuk
# membuktikan OCR benar-benar bekerja di runtime ini. Tanpa berkas itu probe
# melaporkan "tidak mampu" pada container yang sebenarnya sehat — laporan palsu
# ke arah yang berlawanan, tapi tetap laporan palsu.
COPY --chown=racun:racun assets/probe ./assets/probe
# Exact-SHA managed staging trace fixture. Copy only this harmless committed
# staging asset; the runtime gate rejects every other service/env/SHA.
COPY --chown=racun:racun public/staging-fixtures/e2-product.svg ./public/staging-fixtures/e2-product.svg
COPY --chown=racun:racun tsconfig.json ./

# STORAGE_MODE=r2 is required by production config; this writable cache is
# also used by FFmpeg/object materialization and remains non-root.
RUN mkdir -p /srv/app/storage/jobs /srv/app/storage/uploads \
  && chown -R racun:racun /srv/app/storage

USER racun
CMD ["npm", "run", "worker"]
