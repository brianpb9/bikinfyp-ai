[Unit]
Description=Jalankan cadangan BikinFYP tiap malam

[Timer]
# 02:00 WIB. Sejak zona server dipindah ke Asia/Jakarta, systemd membaca
# OnCalendar dalam waktu LOKAL — jadi angka ini harus 02:00, bukan 19:00 UTC
# seperti sebelumnya. Lupa menyesuaikannya berarti cadangan berjalan jam 7
# malam, saat orang justru sedang memakai sistemnya.
OnCalendar=*-*-* 02:00:00
# Kalau server mati saat jadwalnya tiba, jalankan begitu ia hidup lagi.
# Tanpa ini, satu kali reboot berarti satu malam tanpa cadangan, diam-diam.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
