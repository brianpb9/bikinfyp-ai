# Bounded external evidence runner. This is intentionally separate from the
# deployed web runtime: it supplies Playwright + Chromium without changing the
# application image under review. Build only from the exact checked-out SHA:
#   docker build --build-arg EVIDENCE_SOURCE_SHA=$(git rev-parse HEAD) \
#     -f Dockerfile.mobile-evidence -t racun-mobile-evidence:$(git rev-parse HEAD) .
FROM node:22-bookworm-slim

ARG EVIDENCE_SOURCE_SHA
RUN test "$(printf %s "$EVIDENCE_SOURCE_SHA" | wc -c)" -eq 40 \
  && ! printf %s "$EVIDENCE_SOURCE_SHA" | grep -Eq '[^0-9a-f]'

LABEL org.opencontainers.image.revision=$EVIDENCE_SOURCE_SHA \
      ai.hdrv.runner.role="external-managed-evidence"

WORKDIR /srv/evidence
ENV NODE_ENV=development \
    EVIDENCE_SOURCE_SHA=$EVIDENCE_SOURCE_SHA \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY package.json package-lock.json ./
RUN npm ci \
  && npx playwright install --with-deps chromium

COPY lib ./lib
COPY scripts/managed-mobile-auth-hydration.ts ./scripts/managed-mobile-auth-hydration.ts
COPY tsconfig.json ./tsconfig.json

RUN test -f scripts/managed-mobile-auth-hydration.ts \
  && node -e "require('playwright').chromium.executablePath()" \
  && test -x "$(node -e "process.stdout.write(require('playwright').chromium.executablePath())")"

USER node
ENTRYPOINT ["npx", "tsx", "scripts/managed-mobile-auth-hydration.ts"]
