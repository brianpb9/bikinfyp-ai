{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["PASS", "CHANGES_REQUESTED", "FOUNDER_DECISION_REQUIRED"]
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 0 },
          "title": { "type": "string", "minLength": 1 },
          "detail": { "type": "string", "minLength": 1 }
        },
        "required": ["severity", "file", "line", "title", "detail"]
      }
    }
  },
  "required": ["verdict", "sha", "task", "body", "findings"]
}
