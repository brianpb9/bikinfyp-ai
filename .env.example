# Salin ke .env.local
AUTH_SECRET=ganti-dengan-string-acak-panjang-untuk-produksi
# Checkpoint 1A: siapkan URL PostgreSQL untuk deployment nanti. Runtime saat
# ini masih SQLite pada dev/test; SQLite sengaja ditolak bila NODE_ENV=production.
# DATABASE_URL=postgresql://racun:password@localhost:54329/racun_local
DB_PATH=./data/racun.db
STORAGE_DIR=./storage
# Private object storage (Cloudflare R2 via S3 API). Keep bucket private: media
# stays behind /api/files HMAC proxy; no public bucket URL/presigned GET is used.
# STORAGE_MODE=filesystem # local rollback only; production requires r2
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=nama-bucket-private
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_REGION=auto
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
FFPROBE_PATH=/opt/homebrew/bin/ffprobe
# Container worker menetapkan keduanya ke /usr/bin/ffmpeg dan /usr/bin/ffprobe.
# RACUN_DB_RUNTIME=postgres
# RACUN_QUEUE_MODE=redis
# REDIS_URL=redis://<redis-compatible-kv>:6379
# REDIS_QUEUE_NAME=racun-jobs
# WORKER_CONCURRENCY=1

# Provider aktif (mock = provider simulasi lokal, gratis untuk dev/test)
# PROVIDER_VIDEO: mock | byteplus | dashscope
PROVIDER_VIDEO=mock
PROVIDER_VOICE=mock

# BytePlus ModelArk (video) — docs: https://docs.byteplus.com/en/docs/ModelArk/Video_Generation_API
# Model diambil dari TIER (bukan satu variabel global):
#   silent_caption -> seedance-1-0-pro-fast-251015 480p (generate_audio=false)
#   high_quality   -> dreamina-seedance-2-0-mini-260615 (generate_audio=true)
#   super_hq       -> dreamina-seedance-2-0-260128 (generate_audio=true)
BYTEPLUS_ARK_API_KEY=
BYTEPLUS_ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
BYTEPLUS_MODEL_SILENT=seedance-1-0-pro-fast-251015
BYTEPLUS_MODEL_HQ=dreamina-seedance-2-0-mini-260615
BYTEPLUS_MODEL_SUPER=dreamina-seedance-2-0-260128

# TTS terpisah — TIDAK dipakai jalur produksi (keputusan final 31 Jul 2026).
# File google-tts.ts/azure-tts.ts hanya referensi; tidak terdaftar di registry.
GOOGLE_TTS_API_KEY=
AZURE_TTS_KEY=
AZURE_TTS_REGION=

# OTP Email via Resend — kosong = mode mock (kode ke log server [otp-mock])
# Sandbox/testing: RESEND_FROM_EMAIL=onboarding@resend.dev
#
# Produksi memakai no-reply@aiugc.id. Alamat ini DILIHAT PENGGUNA di setiap kode
# login dan setiap struk pembayaran, jadi ia bagian dari merek — bukan setelan
# infrastruktur. Saat pindah domain 5 Sep 2026 ia sempat tertinggal di
# no-reply@bikinfyp.com selama seluruh migrasi, karena tidak ada satu pun
# halaman yang menampilkannya; ketahuan hanya lewat penyisiran env.
#
# Domainnya harus terverifikasi di Resend lebih dulu (SPF/DKIM), kalau tidak
# kirimannya ditolak atau mendarat di spam.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# Monitoring stuck-job/error-rate. Aktifkan hanya dengan Resend API key dan
# inbox founder yang terverifikasi; berjalan dari worker setiap 5 menit.
OPERATIONAL_MONITORING_ENABLED=false
OPERATIONAL_ALERT_TO_EMAIL=
OPERATIONAL_MONITORING_INTERVAL_MIN=5
OPERATIONAL_ALERT_COOLDOWN_MIN=60
OPERATIONAL_ERROR_WINDOW_MIN=60
OPERATIONAL_ERROR_MIN_JOBS=3
OPERATIONAL_ERROR_RATE_PERCENT=20

# OTP WhatsApp — TIDAK DIPAKAI, diganti email 31 Jul 2026 (disimpan sebagai arsip)
# WA_OTP_PROVIDER=fonnte
# FONNTE_API_KEY=
# WATZAP_API_KEY=
# WATZAP_NUMBER_KEY=

# Pembayaran — kosong = checkout 503 jelas.
# Wajib origin HTTPS publik tanpa path; dipakai sebagai callback webhook aman.
APP_BASE_URL=
# Gateway aktif: "duitku" (utama, keputusan 2026-08-19) | "midtrans" (rollback).
PAYMENT_GATEWAY=duitku
# Duitku POP (sandbox.duitku.com → Proyek Saya). JANGAN set DUITKU_IS_PRODUCTION=true
# sebelum Brian bilang siap (default sandbox).
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_IS_PRODUCTION=false
# Midtrans = JALUR ROLLBACK yang sengaja dipertahankan (bukan sisa terlupa).
# Alasan + syarat pencabutannya: docs/adr/0001-gateway-duitku-midtrans-rollback.md
# Midtrans — arsip rollback, tidak dipakai selama PAYMENT_GATEWAY=duitku.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Nomor WhatsApp dukungan (internasional tanpa "+"). Kosong = tombol WA disembunyikan.
SUPPORT_WHATSAPP=628170261628

# Jalur dev (dev-login tanpa OTP, topup instan, webhook stub). Wajib 0 untuk
# RACUN_DEPLOY_ENV=production; staging terisolasi saja yang boleh mengaturnya 1.
ALLOW_DEV_LOGIN=0

# Operasional: closed menolak POST /api/jobs baru (503) namun worker tetap
# memproses antrean yang sudah ada. Ubah melalui deploy env, bukan endpoint.
JOB_INTAKE_MODE=open

# Stub video lain (belum diimplementasi)
DASHSCOPE_API_KEY=

# Kurs & batas waktu per state (menit)
USD_IDR=16300
TIMEOUT_QUEUED_MIN=30
TIMEOUT_VISUAL_MIN=90
TIMEOUT_VOICE_MIN=30
TIMEOUT_COMPOSITING_MIN=20
TIMEOUT_QC_MIN=10
TIMEOUT_LABELING_MIN=10

# LLM opsional untuk mesin skrip (fallback template bila kosong)
LLM_API_KEY=

# Saklar uji failover
MOCK_A_FAIL=0
MOCK_VOICE_A_FAIL=0

# --- Login Google (opsional, tapi tombolnya hanya muncul kalau ini diisi) ---
#
# Kosong = tombol "Masuk pakai Google" DISEMBUNYIKAN dan hanya OTP email yang
# ditawarkan. Itu perilaku yang benar, bukan kegagalan.
#
# Dibuat di Google Cloud Console -> APIs & Services -> Credentials ->
# OAuth client ID -> Web application. Authorized redirect URI harus PERSIS:
#   https://aiugc.id/api/auth/google/callback
# Alamatnya mengikuti DOMAIN YANG DIBUKA PENGUNJUNG, bukan APP_BASE_URL — lihat
# lib/asal-oauth.ts. Jadi selama satu sistem melayani lebih dari satu domain,
# SETIAP domain punya URI-nya sendiri dan semuanya harus terdaftar. Beda satu
# huruf pun ditolak Google dengan redirect_uri_mismatch, dan penolakannya
# terjadi sebelum server kita tersentuh — tidak ada log di sisi kita.
# Halaman /admin/kredensial menampilkan daftar lengkapnya untuk disalin.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
