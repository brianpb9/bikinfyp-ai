# Hanya untuk docker-compose.postgres.yml lokal. Salin sebagai .env.postgres
# bila membutuhkan kredensial dev berbeda; file .env.postgres diabaikan Git.
POSTGRES_USER=racun
POSTGRES_PASSWORD=racun_local_only
POSTGRES_DB=racun_local
POSTGRES_PORT=54329

# Untuk checkpoint berikutnya (jangan tempel kredensial produksi di sini):
DATABASE_URL=postgresql://racun:racun_local_only@localhost:54329/racun_local
